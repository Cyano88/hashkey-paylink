# ─────────────────────────────────────────────────────────
#  Hash PayLink Environment Variables
# ─────────────────────────────────────────────────────────
# Configure the current Privy/Circle wallet integrations below.

VITE_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
HASH_PAYLINK_POLYDESK_SERVICE_TOKEN=
PRIVY_CIRCLE_LINK_STORE=./data/privy-circle-links.json

# Durable server-side storage for Circle wallet mappings, agent subscriptions,
# event receipts, helper profiles, and Nigerian POS merchant QR profiles.
# Required on Render if POS QR links must survive deploys/restarts.
DATABASE_URL=postgres://user:password@host:5432/database
NG_POS_STORE_KEY=hashpaylink:ng-pos-merchants
EVENT_REGISTRY_STORE_KEY=hashpaylink:event-registry
# legacy = RainbowKit/Circle native frontend auth only
# hybrid = enable PrivyProvider while legacy wallet UI remains available
VITE_AUTH_BRIDGE=legacy

# Optional Base connected-wallet gas sponsorship via Coinbase/CDP Paymaster.
# Keep the real CDP URL server-side; expose only this same-origin proxy path.
VITE_BASE_PAYMASTER_URL=/api/base-paymaster
CDP_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/YOUR_CDP_PAYMASTER_KEY

# Optional Circle Paymaster architecture.
# Disabled until the ERC-4337/EIP-7702 user-operation payment path is wired.
# Circle Paymaster charges gas in USDC on supported EVM chains; it does not
# sponsor the merchant payment amount and does not custody funds.
VITE_CIRCLE_PAYMASTER_ENABLED=false
VITE_CIRCLE_BUNDLER_URL_BASE=https://public.pimlico.io/v2/8453/rpc
VITE_CIRCLE_BUNDLER_URL_ARB=https://public.pimlico.io/v2/42161/rpc
# Override only if Circle rotates the v0.8 paymaster address.
VITE_CIRCLE_PAYMASTER_V08_BASE=0x0578cFB241215b77442a541325d6A4E6dFE700Ec
VITE_CIRCLE_PAYMASTER_V08_ARB=0x0578cFB241215b77442a541325d6A4E6dFE700Ec

# Circle Modular Wallets passkey login for "Continue with email" gasless pay.
# Public browser credentials from Circle Modular Wallet Console Setup.
VITE_CLIENT_KEY=
VITE_CLIENT_URL=

# Circle User-Controlled Wallets for email receive/pay flows.
# This is separate from Modular Wallets. CIRCLE_API_KEY stays server-side;
# VITE_CIRCLE_USER_WALLET_APP_ID is the public Wallet App ID.
# Base and Arbitrum require active mainnet Circle Gas Station policies.
# Arc Mainnet requires production Circle credentials and an active Gas Station policy.
# Hash PayLink accepts only live Circle SCA wallets for these EVM flows and
# does not silently fall back to a Hash PayLink relayer.
VITE_CIRCLE_USER_WALLET_APP_ID=
CIRCLE_API_KEY=
CIRCLE_TEST_API_KEY=
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_SOLANA_BLOCKCHAIN=SOL

# Optional Circle Agent Wallet provisioning on /agent.
# Requires Circle CLI installed in the web runtime: npm install -g @circle-fin/cli
CIRCLE_CLI_ENABLED=false
CIRCLE_GATEWAY_API_BASE_MAINNET=https://gateway-api.circle.com
CIRCLE_GATEWAY_API_BASE_TESTNET=https://gateway-api-testnet.circle.com
# Set DATA_PATH to a persistent disk path in production so Circle CLI sessions
# and agent wallet records survive deploys.
DATA_PATH=./data
# AGENT_WALLET_PROVISION_STORE=./data/agent-wallet-provisioning.json
# AGENT_WALLET_CIRCLE_SESSION_PATH=./data/circle-web-sessions
# Platform-pinned agent wallets are public lookup records and cannot be replaced
# from the external agent setup flow. External agents still register into the store.
DEFAULT_AGENT_SLUG=hashpaylink-agent
DEFAULT_AGENT_WALLET_ADDRESS=
# Optional JSON map for additional pinned agents:
# {"research-agent":{"walletAddress":"0x...","chain":"ARC"}}
AGENT_WALLET_REGISTRY=

# Optional Circle Gateway x402 seller endpoint for machine-to-machine agent payments.
X402_SELLER_ADDRESS=
X402_POLYMARKET_SCOUT_PRICE=$0.01
X402_FACILITATOR_URL=https://gateway-api.circle.com
AGENT_WALLET_SERVICE_SECRET=
AGENT_WALLET_ALLOWED_SERVICE_URLS=https://hashpaylink.com/api/x402/polymarket-scout
AGENT_WALLET_MAX_SERVICE_AMOUNT=0.01

# ─────────────────────────────────────────────────────────
#  0G Storage — decentralized payment record archive
#  Chain ID: 16661 | Explorer: chainscan.0g.ai
# ─────────────────────────────────────────────────────────
#  Private key of wallet holding OG tokens (for storage gas).
#  Falls back to RELAYER_PRIVATE_KEY if not set.
OG_STORAGE_KEY=0x_your_og_wallet_private_key

#  Deployed PayLinkArchive contract on 0G Mainnet.
#  Deploy: npx hardhat run scripts/deploy-og-archive.ts --network og
OG_ARCHIVE_ADDRESS=0x_deployed_paylink_archive_address
OG_MEMORY_COMMITMENT_SECRET=replace-with-a-long-random-server-secret

# Durable Pocket support cases. Staff access reuses DEVELOPER_ADMIN_EMAILS.
POCKET_SUPPORT_STORE_KEY=hashpaylink:pocket-support:v1

# ─────────────────────────────────────────────────────────
#  V2 Direct Send (ghost-vault / sponsored relayer)
# ─────────────────────────────────────────────────────────
#  PayLinkFactoryV2 — deployed via Nick's Method, same address on ALL EVM chains.
#  Deployer/relayer/owner: 0x51080f31A21BeDafe50180944606044C12Ea88E4
#  Base USDC:    0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#  Arc USDC:     0x3600000000000000000000000000000000000000
#  Arbitrum USDC: 0xaf88d065e77c8cC2239327C5EDb3A432268e5831
VITE_FACTORY_V2=0x2268B8aad138a550FEf46C621756fEb26b587F78
PAYLINK_FACTORY_V2=0x2268B8aad138a550FEf46C621756fEb26b587F78
VITE_FACTORY_V2_ARC_MAINNET=
PAYLINK_FACTORY_V2_ARC_MAINNET=

#  Relayer wallet private key (0x-prefixed).
#  Wallet: 0x51080f31A21BeDafe50180944606044C12Ea88E4
#  NEVER expose this to the browser (no VITE_ prefix).
RELAYER_PRIVATE_KEY=0x_your_relayer_private_key_here

#  High-rate-limit RPC for the backend relayer (Alchemy / QuickNode).
#  NEVER expose this to the browser.
PRIVATE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_backend_key

#  Arc mainnet RPC (public — no key needed).
PRIVATE_RPC_URL_ARC_MAINNET=https://rpc.mainnet.arc.io
#  Arc relayer key — must be the wallet registered as relayer on the Arc factory.
#  This wallet must hold Arc native USDC for gas. Use a dedicated mainnet relayer key.
RELAYER_PRIVATE_KEY_ARC_MAINNET=0x_arc_deployer_private_key_here

# ─────────────────────────────────────────────────────────
#  Arbitrum + native USDC (relay-arbitrum-usdc.ts + relay-v2.ts arbitrum case)
# ─────────────────────────────────────────────────────────
#  Relayer wallet on Arbitrum One. Needs a small ETH balance for gas
#  (~$5 covers thousands of USDC relays at Arbitrum's cheap gas rates).
#  Falls back to RELAYER_PRIVATE_KEY if unset.
RELAYER_PRIVATE_KEY_ARB=0x_arbitrum_relayer_private_key_here

#  Arbitrum One RPC — use Alchemy/QuickNode for production, public for testing.
PRIVATE_RPC_URL_ARB=https://arb1.arbitrum.io/rpc

#  PayLinkFactoryV2 on Arbitrum One — same Nick's Method address as Base/Arc.
PAYLINK_FACTORY_V2_ARB=0x2268B8aad138a550FEf46C621756fEb26b587F78
VITE_FACTORY_V2_ARB=0x2268B8aad138a550FEf46C621756fEb26b587F78

# EVM reads use /api/evm-read/:network. Configure only server-side RPC variables.
# Never place paid RPC credentials in VITE_ settings.

# Arc Agreements (inactive mainnet deployment boundary).
# Set only after reviewed contracts are deployed and explorer-verified.
# The operator is a dedicated managed signer address; no raw operator key is
# accepted by the agreement runtime configuration.
ARC_AGREEMENT_FACTORY_ADDRESS_MAINNET=
ARC_AGREEMENT_OPERATOR_ADDRESS_MAINNET=
ARC_AGREEMENT_DEPLOYMENT_TX_HASH=0x_reviewed_factory_deployment_transaction
# Read-only schema-v2 manifest used by the post-deployment verifier.
ARC_AGREEMENT_MANIFEST_PATH=deployment/arc-agreement-manifest.json
# Circle developer-controlled ARC wallet UUID. Set only after its
# returned address is verified to equal ARC_AGREEMENT_OPERATOR_ADDRESS_MAINNET.
# Mainnet operator credentials are isolated; see .env.arc-mainnet.example.
ARC_AGREEMENT_OPERATOR_WALLET_ID_MAINNET=
# Generate two different UUID-v4 values once and keep them stable across
# provisioning retries so Circle cannot create duplicate operator resources.
ARC_AGREEMENT_OPERATOR_WALLET_SET_IDEMPOTENCY_KEY_MAINNET=
ARC_AGREEMENT_OPERATOR_WALLET_IDEMPOTENCY_KEY_MAINNET=
ARC_AGREEMENT_OPERATOR_PREFLIGHT_TIMEOUT_MS=10000
ARC_AGREEMENT_CONFIRMATION_BLOCKS=5
# Public activation remains off unless every explicit pilot gate below is set.
# The current API is still draft-only; these values authorize no transaction
# until a separately reviewed payer-signing activation route uses the policy.
ARC_AGREEMENTS_ENABLED=false
# Read-only recovery for transactions already admitted to durable activation
# state. This does not enable agreement creation, signing, or activation.
ARC_AGREEMENT_RECONCILIATION_WORKER_ENABLED=false
# Confirmed-chain discovery for active escrows and lifecycle webhooks. This is
# read-only and independently gated from payer activation.
ARC_AGREEMENT_LIFECYCLE_WORKER_ENABLED=false
# Reviewed operator release/cancellation submission is a separate state-changing
# gate. Keep false until the operations review surface and runbook are approved.
ARC_AGREEMENT_OPERATOR_WORKER_ENABLED=false
ARC_AGREEMENT_OPERATOR_ACTION_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:operator-actions:v1
# Payer cancellation and expiry-refund confirmations are independently gated
# so pausing new activation does not define the eventual escrow-exit policy.
ARC_AGREEMENT_PAYER_LIFECYCLE_ENABLED=false
ARC_AGREEMENT_PAYER_LIFECYCLE_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:payer-lifecycle:v1
ARC_AGREEMENT_ALLOWED_PROJECT_IDS=
ARC_AGREEMENT_ALLOWED_CHECKOUT_MODES=
# Required pilot risk limits. Maximum accepted values are 1,000 USDC per
# agreement, 100 active agreements per project, and 10,000 USDC per UTC day.
ARC_AGREEMENT_MAX_USDC=
ARC_AGREEMENT_MAX_ACTIVE_PER_PROJECT=
ARC_AGREEMENT_DAILY_VOLUME_USDC=
ARC_AGREEMENT_MAX_DURATION_SECONDS=
ARC_AGREEMENT_ACTIVATION_STORE_KEY=hashpaylink:arc-agreement-activation-attempts:v1
# First invite gate is stricter than the code-level pilot maxima: exactly one
# managed human-checkout project, <=1 test USDC per agreement and per UTC day,
# one active agreement, <=7 days, and every runtime switch above false. Verify
# it read-only with:
# npm run preflight:arc-agreement-invite -- --project dev_...
HASHPAYSTREAM_ARC_PROJECT_ID=
# Server-only Arc sandbox key issued to the HashPayStream project. The
# standalone browser must call its own gateway and must never receive this key.
HASHPAYSTREAM_ARC_API_KEY=
# Stable 32+ character HMAC secret used to scope agreements to signed-in
# HashPayStream users independently of the shared developer project.
HASHPAYSTREAM_APP_OWNERSHIP_SECRET=
HASHPAYSTREAM_APP_OWNERSHIP_STORE_KEY=hashpaystream:standalone-agreement-owners:v1
HASHPAYSTREAM_HASH_PAYLINK_BASE_URL=https://app.hashpaylink.com
# Copy the one-time whsec_ value created for the Hash PayStream pilot project.
# This is server-only and must never use a VITE_ prefix.
HASHPAYSTREAM_ARC_WEBHOOK_SECRET=
HASHPAYSTREAM_ARC_WEBHOOK_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:hashpaystream-webhooks:v1

# ─────────────────────────────────────────────────────────
#  Streampay Module — Arc Network
# ─────────────────────────────────────────────────────────
#  Deployed StreamVaultFactory on Arc Mainnet (chainId 5042).
#  Deploy with: npx hardhat run modules/streampay/scripts/deploy.ts --network arc
STREAM_FACTORY_ADDRESS_MAINNET=

#  Browser-accessible factory address (VITE_ prefix exposes it to the frontend).
#  Used by StreamView to pre-compute vault addresses client-side via CREATE2.
#  Must match STREAM_FACTORY_ADDRESS_MAINNET exactly.
VITE_STREAM_FACTORY_ADDRESS_MAINNET=

#  Deployed CheckpointVaultFactory on Arc Mainnet for pay-as-you-read/watch.
#  The server injects this into runtime browser config on production deploys.
CHECKPOINT_FACTORY_ADDRESS_MAINNET=
VITE_CHECKPOINT_FACTORY_ADDRESS_MAINNET=

#  StreamPay Arena escrow factory. Leave empty until the dedicated multiplayer
#  Arena escrow factory is deployed. The UI keeps paid deposits disabled while empty.
ARENA_ESCROW_FACTORY_ADDRESS_MAINNET=
#  Server-side wallet allowed to deploy Arena room escrows and operate room settlement.
#  For the current factory, this must be the same public wallet as the factory relayer.
ARENA_RELAYER_PRIVATE_KEY_MAINNET=0x_your_arena_relayer_private_key_here

#  Optional: automatic recipient setup invites and agent reports.
#  Uses Resend. Configure the same verified mail.hashpaylink.com sender domain
#  used by Circle SMTP.
RESEND_API_KEY=re_your_resend_api_key_here
STREAM_INVITE_FROM_EMAIL=no-reply@mail.hashpaylink.com
STREAM_INVITE_FROM_NAME=StreamPay
AGENTIC_STREAMING_FROM_NAME=Hash PayLink Agent
ALERT_FROM_EMAIL=no-reply@mail.hashpaylink.com
STREAMPAY_BASE_URL=https://hashpaylink.com

#  Creator Studio approval, official cards, and x402 unlock settings.
CREATOR_ADMIN_KEY=
CREATOR_OFFICIAL_WALLET=0x823c31d5e373dd3fa7cad59af05fa45e3858556c
VITE_CREATOR_OFFICIAL_WALLET=0x823c31d5e373dd3fa7cad59af05fa45e3858556c
CREATOR_WORLD_CUP_NEWS_URL=https://www.fifa.com/en/tournaments/mens/worldcup/canadamexicousa2026
CREATOR_WORLD_CUP_NEWS_PRICE_RAW=100000
CREATOR_WORLD_CUP_SCORES_PRICE_RAW=100000
X402_CREATOR_ACCEPT_NETWORKS=eip155:5042
X402_CREATOR_FACILITATOR_URL=https://gateway-api.circle.com
CREATOR_AGENT_X402_PAY_CHAIN=ARC

#  ZeroScout institutional intelligence integration.
#  Server-side only. Never expose the secret with a VITE_ prefix.
ZEROSCOUT_API_URL=https://zeroscout.app
ZEROSCOUT_INTEGRATION_SECRET=zs_live_key_from_zeroscout_dashboard
ZEROSCOUT_HASHWATCH_MEDIA_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
ZEROSCOUT_HASHWATCH_MEDIA_MODEL_CANDIDATES=Qwen/Qwen2.5-VL-72B-Instruct,qwen2.5-vl-72b-instruct,qwen-vl-max-latest,Qwen/Qwen2.5-Omni-7B
ZEROSCOUT_HASHWATCH_MEDIA_PROVIDER=qwen-vl
ZEROSCOUT_HASHWATCH_MEDIA_GUIDANCE_TIMEOUT_MS=90000

#  Arc relayer key and RPC are shared with the InstantPay V2 relayer.
#  These are already declared above (RELAYER_PRIVATE_KEY_ARC_MAINNET, PRIVATE_RPC_URL_ARC_MAINNET).
#  The relay-stream handler falls back to RELAYER_PRIVATE_KEY if the ARC variant is unset.

# Operational endpoint authentication; send credentials in the Authorization header.

#  Secret for admin-only operational endpoints.
#  Required: a long random ADMIN_SECRET; send it only as an Authorization Bearer token.
ADMIN_SECRET=your_random_admin_secret_here

#  Expected Hash PayLink treasury and Arc router factory used by guarded sweeps.
TREASURY_ADDRESS=0xcE5dF9e1115F81a2Fc2F65941B20B820d508e753
PAYMENT_ROUTER_FACTORY_ARC_MAINNET=

#  Block number the PayLinkFactoryV2 was deployed at on Base mainnet.
#  Limits historical dashboard event log scans.
FACTORY_FROM_BLOCK=45786000

# ---------------------------------------------------------------------------
#  Polymarket World Cup Scores
# ---------------------------------------------------------------------------
# Server-side only. Do not prefix the API key with VITE_.
# Recommended provider: sportmonks. Alternative: api-football.
POLY_STREAM_PROVIDER=sportmonks
POLY_STREAM_API_KEY=your_sportmonks_or_api_football_key
POLY_STREAM_LEAGUE_ID=732
POLY_STREAM_SEASON=2026
POLY_STREAM_FIXTURE_MODE=auto
POLY_STREAM_CACHE_MS=60000
POLY_STREAM_LIMIT=12
# Optional. Defaults to safe fixture-list fields for upcoming/results.
# If Sportmonks rejects an include, the API retries with the safe base include.
POLY_STREAM_INCLUDE=
POLY_STREAM_LIVE_INCLUDE=participants;scores;periods;events;league.country;round
POLY_STREAM_DETAIL_INCLUDE=participants;league;venue;state;scores;events.type;events.period;events.player;statistics.type;sidelined.sideline.player;sidelined.sideline.type;weatherReport
POLY_STREAM_DETAIL_LIMIT=6

# Optional. Enabled by default. Sportmonks/API-FOOTBALL supplies match state;
# Polymarket Gamma supplies exact market routing and price context.
POLYMARKET_MARKET_LOOKUP=1
POLYMARKET_LOOKUP_LIMIT=20
POLYMARKET_WORLD_CUP_LIMIT=100
POLYMARKET_BUILDER_CODE=0x_your_polymarket_builder_code
# Polymarket CLOB builder attribution. Users sign with their connected wallet;
# PolyDesk keeps builder credentials server-side and only signs builder headers
# for the exact World Cup order body. PolyDesk does not custody funds or keys.
POLYMARKET_ORDER_SIGNING_ENABLED=0
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Optional alternative to local builder credentials.
POLYMARKET_BUILDER_SIGNER_URL=

# Exact Polymarket event/market links only. Search URLs should not be used here.
# Examples:
# {"USA vs Paraguay":"https://polymarket.com/event/exact-event","sportmonks:123456":"https://polymarket.com/event/exact-event"}
POLYMARKET_MATCH_URLS={}

# ---------------------------------------------------------------------------
# Paycrest Sender API + webhook
# Configure https://hashpaylink.com/api/paycrest-webhook in the Sender Dashboard.
# PAYCREST_API_SECRET verifies the X-Paycrest-Signature over the raw request body.
# ---------------------------------------------------------------------------
PAYCREST_API_BASE=https://api.paycrest.io
PAYCREST_API_KEY=
PAYCREST_API_SECRET=

# ---------------------------------------------------------------------------
# Circle Pocket Bills - VTpass Phase 0 (server-side only)
# Configure the VTpass dashboard callback URL as:
# https://hashpaylink.com/api/vtpass-webhook
# Callback payloads only trigger an authenticated VTpass status requery.
# Keep both feature switches false until sandbox reconciliation and refunds pass.
# The Bills treasury must be an explicit Base EVM address; it never inherits the
# general platform treasury. Do not prefix any of these variables with VITE_.
# ---------------------------------------------------------------------------
VTPASS_ENVIRONMENT=sandbox
VTPASS_API_BASE=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
POCKET_BILLS_ENABLED=false
VTPASS_SANDBOX_VENDING_ENABLED=false
VTPASS_LIVE_VENDING_ENABLED=false
VTPASS_AIRTIME_WHITELIST_CONFIRMED=false
VTPASS_DATA_WHITELIST_CONFIRMED=false
VTPASS_TV_WHITELIST_CONFIRMED=false
VTPASS_ELECTRICITY_WHITELIST_CONFIRMED=false
POCKET_BILLS_REFUNDS_READY=false
# Circle developer-controlled Base SCA for Bills treasury and future refunds.
# Register the entity secret privately and store its recovery file outside this repo.
CIRCLE_ENTITY_SECRET=
POCKET_BILLS_TREASURY_WALLET_SET_IDEMPOTENCY_KEY=
POCKET_BILLS_TREASURY_WALLET_IDEMPOTENCY_KEY=
POCKET_BILLS_TREASURY_WALLET_SET_ID=
POCKET_BILLS_TREASURY_WALLET_ID=
POCKET_BILLS_TREASURY_ADDRESS=
# Commercial USDC checkouts are capped per project across a rolling 24-hour window.
HOSTED_CHECKOUT_DAILY_USDC=500000
VTPASS_MINIMUM_WALLET_BALANCE_NGN=5000
POCKET_BILLS_STORE_KEY=hashpaylink:pocket-bills:v1
# Live must use a separate namespace, for example:
# POCKET_BILLS_STORE_KEY=hashpaylink:pocket-bills:live:v1

# ---------------------------------------------------------------------------
# Hosted Checkout private beta
# Generate a random signing secret with at least 32 characters.
# Partner key configuration maps each server-side API key to its identity and
# exact allowlisted return origins. Never expose either variable with VITE_.
# ---------------------------------------------------------------------------
HOSTED_CHECKOUT_SIGNING_SECRET=
# Optional dedicated key for public receipt capability links. When blank, the
# server uses HOSTED_CHECKOUT_SIGNING_SECRET for the receipt HMAC.
RECEIPT_SIGNING_SECRET=
HASH_PAYLINK_PARTNER_API_KEYS={}
HOSTED_CHECKOUT_STORE_KEY=hashpaylink:hosted-checkouts:v2
# Durable provider-funding request mapping. Use a distinct namespace per environment.
POLYMARKET_FUNDING_CHECKOUT_STORE_KEY=hashpaylink:polymarket-funding-checkouts:v1
PARTNER_ACCESS_STORE_KEY=hashpaylink:partner-access-requests

# Developer portal projects, generated API-key hashing, and encrypted payout/webhook configuration.
# Generate a unique random value of at least 32 characters and keep it server-side.
DEVELOPER_PORTAL_SECRET=
DEVELOPER_PROJECT_STORE_KEY=hashpaylink:developer-projects:v1

# ---------------------------------------------------------------------------
# Biller Provider Probe
# ---------------------------------------------------------------------------
# Dry-run adapter probe for comparing biller APIs before production wiring.
# Real vending requires --execute and BILLER_PROBE_EXECUTE=true.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token
RELOADLY_AIRTIME_BASE_URL=https://topups-sandbox.reloadly.com
RELOADLY_AIRTIME_AUDIENCE=https://topups.reloadly.com
RELOADLY_UTILITY_BASE_URL=https://utilities-sandbox.reloadly.com
RELOADLY_UTILITY_AUDIENCE=https://utilities-sandbox.reloadly.com
RELOADLY_OPERATOR_ID=

DTONE_BASE_URL=https://preprod-dvs-api.dtone.com/v1
DTONE_API_KEY=
DTONE_API_SECRET=
DTONE_PRODUCT_ID=
DTONE_CALLBACK_URL=

BAXI_BASE_URL=
BAXI_API_KEY=
BAXI_AUTH_HEADER=x-api-key
BAXI_SERVICE_ID=

BILLER_PROBE_COUNTRY=NG
BILLER_PROBE_CATEGORY=electricity
BILLER_PROBE_CUSTOMER=
BILLER_PROBE_AMOUNT=100
BILLER_PROBE_EXECUTE=false

# Reviewed mainnet memo wrapper for existing external-wallet stream creation.
VITE_ARC_MEMO_ADDRESS_MAINNET=

# Preserve existing PIN pepper; changing it requires a migration/reset plan.
POCKET_PIN_PEPPER=
# At least 32 characters; signs Arc and XStocks quotes independently of Privy.
POCKET_SWAP_QUOTE_SECRET=
