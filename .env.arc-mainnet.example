# Arc Agreements mainnet configuration. Copy selected settings into the deployment
# secret manager only after obtaining production Circle access and release review.
# No legacy Arc testnet credential, wallet id or store override is inherited.
PRIVATE_RPC_URL_ARC_MAINNET=https://rpc.mainnet.arc.io
ARC_AGREEMENT_FACTORY_ADDRESS_MAINNET=
ARC_AGREEMENT_OPERATOR_ADDRESS_MAINNET=
ARC_AGREEMENT_OPERATOR_WALLET_ID_MAINNET=
CIRCLE_API_KEY_ARC_MAINNET=
CIRCLE_ENTITY_SECRET_ARC_MAINNET=

ARC_AGREEMENT_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:agreements:v1
ARC_AGREEMENT_ACTIVATION_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:activation-attempts:v1
ARC_AGREEMENT_OPERATOR_ACTION_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:operator-actions:v1
ARC_AGREEMENT_PAYER_LIFECYCLE_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:payer-lifecycle:v1
ARC_AGREEMENT_WEBHOOK_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:webhooks:v1
ARC_AGREEMENT_VERIFIED_RECIPIENT_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:verified-recipients:v1
HASHPAYSTREAM_ARC_WEBHOOK_STORE_KEY_MAINNET=hashpaylink:arc-mainnet:5042:hashpaystream-webhooks:v1

ARC_AGREEMENTS_ENABLED=false
ARC_AGREEMENT_RECONCILIATION_WORKER_ENABLED=false
ARC_AGREEMENT_LIFECYCLE_WORKER_ENABLED=false
ARC_AGREEMENT_OPERATOR_WORKER_ENABLED=false
ARC_AGREEMENT_PAYER_LIFECYCLE_ENABLED=false
