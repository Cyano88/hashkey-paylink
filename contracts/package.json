{
  "name": "@hashpaylink/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "PaymentRouter + PaymentRouterFactory — deploy once per chain, route forever.",
  "scripts": {
    "compile":        "hardhat compile",
    "test":           "hardhat test",
    "test:agreements": "hardhat test test/ArcAgreementEscrow.test.ts test/ArcAgreementInvariant.test.ts test/ArcAgreementDeploymentPlan.test.ts test/ArcAgreementDeploymentVerifier.test.ts test/ArcAgreementReviewBundle.test.ts",
    "plan:arc-agreements": "hardhat run scripts/arc-agreement-deployment-plan.ts --network hardhat",
    "bundle:arc-agreements-review": "hardhat run --no-compile scripts/arc-agreement-review-bundle.ts --network hardhat",
    "verify:arc-agreements": "hardhat run --no-compile scripts/arc-agreement-deployment-verify.ts --network arc",
    "deploy:base":    "hardhat run scripts/deploy.ts --network base",
    "deploy:arc":     "hardhat run scripts/deploy.ts --network arc",
    "verify:base":    "hardhat verify --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "hardhat": "^2.22.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0"
  }
}
