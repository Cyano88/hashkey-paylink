<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/pocket_launch_background</item>
        <item name="android:navigationBarColor">@color/pocket_launch_background</item>
        <item name="android:statusBarColor">@color/pocket_launch_background</item>
        <item name="android:windowLightStatusBar">@bool/pocket_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/pocket_light_system_bars</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/pocket_launch_background</item>
        <item name="windowSplashScreenBackground">@color/pocket_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pocket_launch_icon</item>
        <item name="android:windowLightStatusBar">@bool/pocket_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/pocket_light_system_bars</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
