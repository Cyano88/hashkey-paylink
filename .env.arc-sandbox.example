# Arc Agreement sandbox configuration reference
# Use only in an isolated sandbox service running a verified testnet adapter.
# This file preserves configuration intent; it does not enable sandbox execution.
# Never load it into the live Agreement service.
ARC_SANDBOX_CHAIN_ID=5042002
ARC_SANDBOX_RPC_URL=https://rpc.testnet.arc.io
CIRCLE_TEST_API_KEY=
# Legacy testnet adapter names, retained only for that sandbox deployment:
ARC_AGREEMENT_FACTORY_ADDRESS=
ARC_AGREEMENT_OPERATOR_ADDRESS=
ARC_AGREEMENT_OPERATOR_WALLET_ID=
ARC_AGREEMENTS_ENABLED=false
ARC_AGREEMENT_RECONCILIATION_WORKER_ENABLED=false
ARC_AGREEMENT_LIFECYCLE_WORKER_ENABLED=false
ARC_AGREEMENT_OPERATOR_WORKER_ENABLED=false
ARC_AGREEMENT_PAYER_LIFECYCLE_ENABLED=false
# Supply a dedicated sandbox entity secret using the sandbox adapter's expected name.
# Never inherit live *_MAINNET settings or production data stores.
